# Antigravity Mobile Sync Gateway — Environment Configuration
# Copy this file to `.env` and customize for your setup.

# Local listen address and port
AGY_MOBILE_HOST=0.0.0.0
AGY_MOBILE_PORT=8899

# Optional: Public Cloud Reverse SSH Tunnel Relay
# If set, gateway.py automatically maintains an SSH reverse tunnel (`ssh -R 127.0.0.1:18899:127.0.0.1:8899 <HOST>`)
AGY_VPS_SSH_HOST=
AGY_VPS_PUBLIC_IP=
AGY_VPS_PUBLIC_URL=

# Optional: Comma-separated conversation IDs to hide from the mobile sidebar
AGY_HIDDEN_CONV_IDS=
